Bootstrap: docker
From: ubuntu:22.04


%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y \
        python3 python3-pip libjpeg-dev zlib1g-dev git libgl1-mesa-glx \
        libglib2.0-0 libgtk2.0-dev
    
    python3 -m pip install --upgrade pip setuptools wheel
    
    # Core scientific stack
    pip install numpy==1.26.4 pandas scikit-learn matplotlib pillow requests
    
    # Install PyTorch first
    pip install torch torchvision torchaudio decord
    
    # Hugging Face ecosystem
    pip install evaluate transformers accelerate datasets
    
    # Install OpenCV headless (no SPIGA installation here!)
    # UNINSTALL OPENCV
    pip uninstall --yes opencv-python
    pip install opencv-python-headless
    
    # Install SPIGA's dependencies without SPIGA itself
    pip install scipy imgaug opencv-python-headless
    
    # instal wandb
    pip install wandb

%environment
    # Ensure pip-installed binaries are in PATH
    export PATH=/usr/local/bin:$PATH

%test
    python3 --version
    python3 -c "import torch; \
                print('PyTorch:', torch.__version__); \
                print('CUDA available:', torch.cuda.is_available())"
